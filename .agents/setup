#!/usr/bin/env bash
# Amp orb setup for metabolic-ledger.
#
# Amp runs this from the repository root when it builds a project orb snapshot
# (Debian 12, CPU only: orbs have no GPU). It must finish within 20 minutes and
# be safe to run more than once. See https://ampcode.com/docs/orbs/customizing
#
# Installs only what this repo's CI and manifests need:
#   - apt: build-essential, curl, ca-certificates
#   - Rust stable (+rustfmt, clippy) [default]
#   - cargo fetch
#
# It ends with a dependency fetch/prebuild, not a test run.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  SUDO="sudo"
fi

# Install Debian packages that are not already present.
apt_install() {
  local missing=() pkg
  for pkg in "$@"; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
      missing+=("$pkg")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    $SUDO apt-get -o Acquire::Retries=5 update -qq
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends "${missing[@]}"
  fi
}

# --- System packages (C toolchain/linker for rustc and build scripts; curl for the installers) ---
apt_install build-essential curl ca-certificates

# --- Rust (rustup) ---
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --default-toolchain none --profile minimal
fi
# CI (ci.yml) uses stable + rustfmt, clippy.
rustup toolchain install stable --profile minimal --component rustfmt --component clippy
rustup default stable

# --- Prefetch crates (no build, no tests) ---
# Cargo.lock is gitignored here, so this resolves a fresh (ignored) lockfile.
cargo fetch

echo "Amp orb setup for metabolic-ledger finished."
